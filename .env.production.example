# VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO — Digital Ocean
# Copie este ficheiro para .env e configure os valores

# ⚠️ SEGURANÇA: Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA use a chave do desenvolvimento em produção
SECRET_KEY=GERAR-COM-COMANDO-ACIMA-MINIMO-64-CARACTERES

# Password do painel de gestão — Mude para algo seguro
GESTAO_PASSWORD=MUDE-PARA-PASSWORD-FORTE

# Base de dados SQLite em produção — Path absoluto no servidor
# O directório /var/www/mci_indicadores/instance/ deve existir e ser gravável
DATABASE_URL=sqlite:////var/www/mci_indicadores/instance/mci_indicadores.db

# Debug SEMPRE desligado em produção
FLASK_DEBUG=false

# Logging — ajuste conforme necessário
LOG_LEVEL=INFO
